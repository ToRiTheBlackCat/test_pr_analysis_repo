<Window x:Class="ASCIIImageConvertorMain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ASCIIImageConvertorMain"
        mc:Ignorable="d"
        Title="MainWindow" Height="686" Width="1015" WindowStartupLocation="CenterScreen" Background="#FFA09DFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="387"/>
            <!-- For controls like buttons and textboxes -->
            <RowDefinition/>
            <!-- For the WebBrowser -->
        </Grid.RowDefinitions>

        <Button x:Name="browseButton" Content="Browse" HorizontalAlignment="Left" Margin="414,22,0,0" VerticalAlignment="Top" Click="browseButton_Click" Height="27" Width="90" Background="#FF72F7B7" Foreground="White"/>
        <TextBox x:Name="urlTextBox" HorizontalAlignment="Left" Margin="26,22,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="347" Height="23"/>
        <Image x:Name="image" HorizontalAlignment="Left" Height="318" Margin="26,294,0,0" VerticalAlignment="Top" Width="285" Grid.RowSpan="2">
            <Image.OpacityMask>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Image.OpacityMask>

        </Image>
        <Button x:Name="convertButton" Content="Convert" HorizontalAlignment="Left" Margin="112,175,0,0" VerticalAlignment="Top" Click="convertButton_Click" Height="64" Width="174" Background="#FFEA9C78" Foreground="White" FontSize="18" FontWeight="Bold"/>
        <WebBrowser x:Name="asciiArtWebBrowser" Margin="343,90,10,0" Height="570" VerticalAlignment="Top" Grid.RowSpan="2"/>
        <!-- Adjust dimensions as needed -->
    </Grid>
</Window>
